FROM php:8.5-fpm

# Security hotfix (CVE-2026-109618/109619): upload-progress tracking is not used anywhere,
# so switch it off to close the reported session.upload_progress attack path.
RUN echo "session.upload_progress.enabled = Off" > /usr/local/etc/php/conf.d/zz-security.ini

RUN set -eux; \
    apt update; \
    apt install -y \
        git \
        unzip \
        libicu-dev \
        libpq-dev \
        libzip-dev \
    ; \
    docker-php-ext-install zip pdo_mysql; \
    apt clean; \
    rm -rf /var/lib/apt/lists/*

# Xdebug (debugging) and PCOV (fast coverage) via PIE (sources from GitHub):
# pecl.php.net is unreliable and its REST channel is discontinued.
COPY --from=ghcr.io/php/pie:bin /pie /usr/bin/pie
RUN pie install --skip-enable-extension xdebug/xdebug \
    && pie install --skip-enable-extension pecl/pcov \
    && docker-php-ext-enable xdebug pcov

# Create initial xdebug config (disabled by default for performance)
RUN echo ";zend_extension=xdebug.so" > /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

EXPOSE 9000
CMD ["php-fpm"]

