{
    "name": "vandersangen/project-template-bundle",
    "type": "symfony-bundle",
    "description": "Reusable Symfony bundle with authentication, user management, and master data loading",
    "keywords": ["symfony", "bundle", "authentication", "jwt", "master-data"],
    "license": "MIT",
    "homepage": "https://github.com/vandersangen/project-template-bundle",
    "authors": [
        {
            "name": "Lars van der Sangen",
            "email": "lars@vandersangen.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/vandersangen/project-template-bundle/issues",
        "source": "https://github.com/vandersangen/project-template-bundle"
    },
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "dragonmantank/cron-expression": "^3.3",
        "knplabs/knp-snappy": "^1.5",
        "lexik/jwt-authentication-bundle": "^3.2",
        "spomky-labs/otphp": "^11.2",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/password-hasher": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "sentry/sentry-symfony": "^5.0",
        "symfony/monolog-bundle": "^4.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "nelmio/cors-bundle": "^2.6",
        "phpmd/phpmd": "^2.15",
        "phpro/grumphp": "^2.10",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "slevomat/coding-standard": "^8.22",
        "squizlabs/php_codesniffer": "^3.11",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/runtime": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "VanDerSangen\\ProjectTemplateBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VanDerSangen\\ProjectTemplateBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
